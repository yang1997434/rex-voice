<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by scripts/install-launchd.sh, which may add EnvironmentVariables.REX_VOICE_RELAY.
     The OpenAI key is fetched at start by flow-cred and never stored here. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.maruiao.rex-voiced</string>
  <key>ProgramArguments</key><array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>OPENAI_API_KEY=$(/Users/andy/.local/bin/flow-cred OPENAI_API_KEY) exec /Users/andy/.local/bin/rex-voiced serve</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>/Users/andy</string>
    <key>PATH</key><string>/usr/bin:/bin:/opt/homebrew/bin:/Users/andy/.local/bin:/Users/andy/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/andy/Library/Logs/rex-voice/rex-voiced.log</string>
  <key>StandardErrorPath</key><string>/Users/andy/Library/Logs/rex-voice/rex-voiced.log</string>
  <key>ProcessType</key><string>Interactive</string>
</dict></plist>
